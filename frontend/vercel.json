{https://coffee-brew-app.onrender.com
# Move to the frontend directory
cd /workspaces/-Coffee--brew-app/frontend 2>/dev/null || cd frontend 2>/dev/null

# Overwrite the file with your true destination link (Paste your link on the destination line!)
cat << 'EOF' > vercel.json
{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://onrender.com*"
    }
  ]
}
EOF
